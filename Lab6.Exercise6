#include <stdio.h>

int main() {
    int n, isIdentity = 1;
    printf("Enter size of matrix: ");
    scanf("%d", &n);

    int matrix[n][n];
    printf("Enter the matrix elements:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &matrix[i][j]);
            if ((i == j && matrix[i][j] != 1) || (i != j && matrix[i][j] != 0)) {
                isIdentity = 0;
            }
        }
    }

    if (isIdentity) {
        printf("Yes\n");
    } else {
        printf("No\n");
    }
    return 0;
}


#include <stdio.h>

int main() {
    int n, a = 0, b = 1, fib;
    printf("Enter n: ");
    scanf("%d", &n);

    if (n == 0) {
        fib = 0;
    } else if (n == 1) {
        fib = 1;
    } else {
        for (int i = 2; i <= n; i++) {
            fib = a + b;
            a = b;
            b = fib;
        }
    }

    printf("Fibonacci number: %d\n", fib);
    return 0;
}

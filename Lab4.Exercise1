#include <stdio.h>

int main() {
    int n, sum = 0;
    printf("Enter n: ");
    scanf("%d", &n);

    int arr[n];
    printf("Enter %d integers: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
        sum += arr[i];
    }

    double avg = (double)sum / n;
    printf("Elements less than the average: ");
    for (int i = 0; i < n; i++) {
        if (arr[i] < avg) {
            printf("%d ", arr[i]);
        }
    }
    printf("\n");
    return 0;
}

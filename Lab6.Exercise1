#include <stdio.h>

int main() {
    int n, sum = 0;
    printf("Enter size of matrix: ");
    scanf("%d", &n);

    int matrix[n][n];
    printf("Enter the matrix elements:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            scanf("%d", &matrix[i][j]);
            if (i > j) {
                sum += matrix[i][j];
            }
        }
    }

    printf("Sum under main diagonal: %d\n", sum);
    return 0;
}


#include <stdio.h>

int main() {
    char text[1000], result[1000];
    int i = 0, j = 0;

    printf("Enter text: ");
    gets(text);

    while (text[i] != '\0') {
        if (!(text[i] == ' ' && text[i+1] == ' ')) {
            result[j++] = text[i];
        }
        i++;
    }
    result[j] = '\0';

    printf("Normalized text: %s\n", result);
    return 0;
}


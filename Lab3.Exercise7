#include <stdio.h>

int main() {
    int n, num, sumEven = 0, sumOdd = 0;
    printf("Enter the number of integers: ");
    scanf("%d", &n);

    for (int i = 0; i < n; i++) {
        scanf("%d", &num);
        if (num % 2 == 0) {
            sumEven += num;
        } else {
            sumOdd += num;
        }
    }

    printf("Sum of evens: %d\n", sumEven);
    printf("Sum of odds: %d\n", sumOdd);
    return 0;
}

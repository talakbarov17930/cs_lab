#include <stdio.h>

int main() {
    int n, el;
    printf("Enter n: ");
    scanf("%d", &n);

    int arr[n + 1];
    printf("Enter %d sorted integers: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Enter element to insert: ");
    scanf("%d", &el);

    int pos = 0;
    while (pos < n && arr[pos] < el) {
        pos++;
    }

    for (int i = n; i > pos; i--) {
        arr[i] = arr[i - 1];
    }
    arr[pos] = el;

    printf("Position: %d\nNew array: ", pos);
    for (int i = 0; i <= n; i++) {
        printf("%d ", arr[i]);
    }
    printf("\n");
    return 0;
}

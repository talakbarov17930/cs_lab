#include <stdio.h>
#include <string.h>

int main() {
    char text[1000];
    int count = 1;

    printf("Enter text: ");
    gets(text);

    for (int i = 0; text[i] != '\0'; i++) {
        if (text[i] == '#') {
            count++;
        }
    }

    printf("Number of tokens: %d\n", count);
    return 0;
}


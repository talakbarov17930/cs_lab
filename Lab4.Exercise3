#include <stdio.h>

int main() {
    int n, k;
    printf("Enter n and k: ");
    scanf("%d %d", &n, &k);

    int arr[n];
    printf("Enter %d integers: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Reversed in groups:\n");
    for (int i = n - 1; i >= 0; i -= k) {
        int end = i;
        int start = (i - k + 1 >= 0) ? i - k + 1 : 0;
        for (int j = end; j >= start; j--) {
            printf("%d ", arr[j]);
        }
        printf("\n");
    }
    return 0;
}

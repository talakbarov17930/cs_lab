#include <stdio.h>

int main() {
    int n;
    printf("Enter n: ");
    scanf("%d", &n);

    int arr[n];
    printf("Enter %d integers: ", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    printf("Elements less than both neighbors: ");
    for (int i = 0; i < n; i++) {
        if ((i == 0 && arr[i] < arr[i + 1]) || 
            (i == n - 1 && arr[i] < arr[i - 1]) || 
            (i > 0 && i < n - 1 && arr[i] < arr[i - 1] && arr[i] < arr[i + 1])) {
            printf("%d ", arr[i]);
        }
    }
    printf("\n");
    return 0;
}

#include <stdio.h>

int main() {
    int n, length = 0;
    printf("Enter a positive integer: ");
    scanf("%d", &n);

    while (n != 1) {
        printf("%d ", n);
        if (n % 2 == 0) {
            n /= 2;
        } else {
            n = 3 * n + 1;
        }
        length++;
    }
    printf("1\nLength: %d\n", length + 1);
    return 0;
}

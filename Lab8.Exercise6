#include <stdio.h>

void concatenate(char *str1, char *str2) {
    while (*str1 != '\0') {
        str1++;
    }
    while (*str2 != '\0') {
        *str1 = *str2;
        str1++;
        str2++;
    }
    *str1 = '\0';
}

int main() {
    char str1[200], str2[100];
    scanf("%s %s", str1, str2);
    concatenate(str1, str2);
    printf("Concatenated string: %s\n", str1);
    return 0;
}

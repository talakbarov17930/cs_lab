#include <stdio.h>

int main() {
    int n, m;
    printf("Enter rows and columns of matrix: ");
    scanf("%d %d", &n, &m);

    int matrix[n][m];
    printf("Enter the matrix elements:\n");
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            scanf("%d", &matrix[i][j]);
        }
    }

    printf("Matrix with row and column sums:\n");
    int colSums[m];
    for (int j = 0; j < m; j++) colSums[j] = 0;

    for (int i = 0; i < n; i++) {
        int rowSum = 0;
        for (int j = 0; j < m; j++) {
            printf("%d ", matrix[i][j]);
            rowSum += matrix[i][j];
            colSums[j] += matrix[i][j];
        }
        printf("| %d\n", rowSum);
    }

    printf("_ ");
    for (int j = 0; j < m; j++) {
        printf("%d ", colSums[j]);
    }
    printf("\n");
    return 0;
}


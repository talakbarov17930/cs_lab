#include <stdio.h>
#include <math.h>

int pointInCircle(float x0, float y0, float radius, float x, float y) {
    float distance = sqrt(pow(x - x0, 2) + pow(y - y0, 2));
    if (distance < radius) return -1;
    else if (distance == radius) return 0;
    else return 1;
}

int main() {
    float x0, y0, radius;
    printf("Enter circle center (x0, y0) and radius: ");
    scanf("%f %f %f", &x0, &y0, &radius);

    printf("Enter number of points: ");
    int n;
    scanf("%d", &n);

    float points[n][2];
    printf("Enter points (x, y):\n");
    for (int i = 0; i < n; i++) {
        scanf("%f %f", &points[i][0], &points[i][1]);
    }

    for (int i = 0; i < n; i++) {
        int result = pointInCircle(x0, y0, radius, points[i][0], points[i][1]);
        if (result == -1) printf("Point (%.2f, %.2f) is inside the circle\n", points[i][0], points[i][1]);
        else if (result == 0) printf("Point (%.2f, %.2f) is on the circle\n", points[i][0], points[i][1]);
        else printf("Point (%.2f, %.2f) is outside the circle\n", points[i][0], points[i][1]);
    }

    return 0;
}


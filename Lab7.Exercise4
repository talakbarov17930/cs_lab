#include <stdio.h>
#include <math.h>

int pointInCircle(float x0, float y0, float radius, float x, float y) {
    float distance = sqrt(pow(x - x0, 2) + pow(y - y0, 2));
    if (distance < radius) return -1;
    else if (distance == radius) return 0;
    else return 1;
}

int main() {
    float x0, y0, radius, x, y;
    printf("Enter circle center (x0, y0) and radius: ");
    scanf("%f %f %f", &x0, &y0, &radius);
    printf("Enter point (x, y): ");
    scanf("%f %f", &x, &y);
    int result = pointInCircle(x0, y0, radius, x, y);
    if (result == -1) printf("Point is inside the circle\n");
    else if (result == 0) printf("Point is on the circle\n");
    else printf("Point is outside the circle\n");
    return 0;
}

